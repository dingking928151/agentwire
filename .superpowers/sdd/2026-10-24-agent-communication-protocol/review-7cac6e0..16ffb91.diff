+@pytest.fixture
+def api():
+    try:
+        return importlib.import_module("agentcodec.agentwire.benchmark")
+    except ModuleNotFoundError as error:
+        if error.name == "agentcodec.agentwire.benchmark":
+            class MissingBenchmark:
+                def __getattr__(self, name):
