+
+
+def _row(scenario_report, *, candidate, mode="gateway", total_uses=1):
+    return next(
+        row for row in scenario_report.rows
+        if row.candidate_id == candidate
+        and row.receiver_mode == mode
+        and row.total_uses == total_uses
+    )
+
