+++ b/src/agentcodec/agentwire/contracts.py
@@ -0,0 +1,294 @@
+"""Strict, side-effect-free contracts for AgentWire v1."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+from typing import Annotated, Literal, TypeAlias
+
+from pydantic import (
+    BaseModel,
+    ConfigDict,
+    Field,
+    PositiveInt,
+    StringConstraints,
+    TypeAdapter,
+    ValidationError,
+    model_validator,
+)
+from agentcodec.schema import Identifier, MessageV1, UnicodeText, UserDictionary
+
+
+Sha256Hex: TypeAlias = Annotated[str, StringConstraints(pattern=r"^[0-9a-f]{64}$")]
+BenchmarkCandidate: TypeAlias = Literal[
+    "natural_language",
+    "natural_language_freeform",
+    "json",
+    "ac1",
+    "ac1_dictionary",
+    "ac2",
+    "ac2_dictionary",
+    "awp1",
+    "awp1_dictionary",
+]
+AgentWireReasonCode: TypeAlias = Literal[
+    "unsupported_profile",
+    "unsupported_schema",
+    "unsupported_enum_table",
+    "receiver_user_mismatch",
+    "message_too_large",
+    "invalid_envelope",
+    "unknown_enum",
+    "dictionary_missing",
+    "dictionary_identity_mismatch",
+    "unknown_alias",
+    "invalid_message",
+]
+CostPartLabel: TypeAlias = Literal[
+    "setup", "negotiation", "protocol_instructions", "context",
+    "dictionary_glossary", "dictionary_transfer", "payload", "response",
+    "retry", "fallback", "other",
+]
+CostEventKind: TypeAlias = Literal[
+    "setup", "negotiation", "dictionary_distribution", "request",
+    "response", "retry", "fallback",
+]
+CostSurface: TypeAlias = Literal["transport", "model_input", "model_output"]
+CostUnavailableReason: TypeAlias = Literal[
+    "tokenizer_unavailable", "profile_unreliable", "surrogate_only",
+]
+NonnegativeInt = Annotated[int, Field(ge=0)]
+
+COST_PART_LABELS = (
+    "setup", "negotiation", "protocol_instructions", "context",
+    "dictionary_glossary", "dictionary_transfer", "payload", "response",
+    "retry", "fallback", "other",
+)
+COST_EVENT_KINDS = (
+    "setup", "negotiation", "dictionary_distribution", "request",
+    "response", "retry", "fallback",
+)
+
+_REASON_CODE_ADAPTER = TypeAdapter(AgentWireReasonCode)
+
+
+class _StrictFrozenModel(BaseModel):
+    model_config = ConfigDict(
+        strict=True,
+        frozen=True,
+        extra="forbid",
+        hide_input_in_errors=True,
+    )
+
+
+class DictionaryIdentity(_StrictFrozenModel):
+    user_id: Identifier
+    version: Identifier
+    sha256: Sha256Hex
+
+
+class ReceiverCapabilities(_StrictFrozenModel):
+    user_id: Identifier
+    supported_profile_versions: tuple[str, ...]
+    supported_schema_versions: tuple[str, ...]
+    supported_enum_table_versions: tuple[str, ...]
+    max_message_bytes: PositiveInt
+    dictionary_identity: DictionaryIdentity | None
+
+    @model_validator(mode="after")
+    def reject_duplicate_versions(self) -> ReceiverCapabilities:
+        for field_name in (
+            "supported_profile_versions",
+            "supported_schema_versions",
+            "supported_enum_table_versions",
+        ):
+            versions = getattr(self, field_name)
+            if len(set(versions)) != len(versions):
+                raise ValueError(f"{field_name} must not contain duplicate versions")
+        return self
+
+
+class NegotiationResult(_StrictFrozenModel):
+    status: Literal["supported", "fallback_required"]
+    reason_code: AgentWireReasonCode | None
+
+    @model_validator(mode="after")
+    def enforce_status_reason_pair(self) -> NegotiationResult:
+        success = self.status == "supported"
+        if success != (self.reason_code is None):
+            raise ValueError("negotiation status and reason_code are inconsistent")
+        return self
+
+
+class GatewayResult(_StrictFrozenModel):
+    status: Literal["decoded", "fallback_required"]
+    message: MessageV1 | None
+    reason_code: AgentWireReasonCode | None
+
+    @model_validator(mode="after")
+    def enforce_status_payload_pair(self) -> GatewayResult:
+        success = self.status == "decoded"
+        if success != (self.message is not None and self.reason_code is None):
+            raise ValueError("gateway status and result fields are inconsistent")
+        if not success and (self.message is not None or self.reason_code is None):
+            raise ValueError("fallback result must contain only a stable reason code")
+        return self
+
+
+class GatewayDelivery(_StrictFrozenModel):
+    candidate_id: BenchmarkCandidate
+    decode_status: Literal["decoded", "fallback_required", "pass_through"]
+    model_context: str | None
+    pass_through_text: str | None
+    reason_code: AgentWireReasonCode | None
+
+    @model_validator(mode="after")
+    def enforce_delivery_state(self) -> GatewayDelivery:
+        if self.decode_status == "decoded":
+            if (
+                self.candidate_id == "natural_language_freeform"
+                or self.model_context is None
+                or not self.model_context
+                or self.pass_through_text is not None
+                or self.reason_code is not None
+            ):
+                raise ValueError("decoded delivery fields are inconsistent")
+            try:
+                decoded_message = MessageV1.model_validate(
+                    json.loads(self.model_context), strict=True
+                )
+                canonical_context = json.dumps(
+                    decoded_message.model_dump(),
+                    ensure_ascii=False,
+                    separators=(",", ":"),
+                )
+            except (json.JSONDecodeError, TypeError, ValueError, ValidationError):
+                raise ValueError(
+                    "decoded model_context must be canonical MessageV1 JSON"
+                ) from None
+            if self.model_context != canonical_context:
+                raise ValueError(
+                    "decoded model_context must be canonical MessageV1 JSON"
+                )
+        elif self.decode_status == "fallback_required":
+            if (
+                self.model_context is not None
+                or self.pass_through_text is not None
+                or self.reason_code is None
+            ):
+                raise ValueError("fallback delivery must contain only a stable reason code")
+        elif (
+            self.candidate_id != "natural_language_freeform"
+            or self.model_context is not None
+            or self.pass_through_text is None
+            or self.reason_code is not None
+        ):
+            raise ValueError("pass-through delivery fields are inconsistent")
+        return self
+
+
+class AgentWireError(Exception):
+    """An error exposing only one stable, non-sensitive reason code."""
+
+    def __init__(self, reason_code: AgentWireReasonCode) -> None:
+        try:
+            validated = _REASON_CODE_ADAPTER.validate_python(reason_code, strict=True)
+        except ValidationError:
+            raise ValueError("invalid AgentWire reason code") from None
+        self.reason_code: AgentWireReasonCode = validated
+        super().__init__("agentwire operation rejected")
+
+
+def dictionary_identity_for(dictionary: UserDictionary) -> DictionaryIdentity:
+    """Hash the full strict, recursively snapshotted UserDictionary content."""
+    snapshot = copy.deepcopy(dictionary.model_dump(warnings=False))
+    validated = UserDictionary.model_validate(snapshot, strict=True)
+    canonical = json.dumps(
+        validated.model_dump(),
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8")
+    return DictionaryIdentity(
+        user_id=validated.user_id,
+        version=validated.version,
+        sha256=hashlib.sha256(canonical).hexdigest(),
+    )
+
+
+class CostPart(_StrictFrozenModel):
+    label: CostPartLabel
+    text: UnicodeText
+
+
+class CostEvent(_StrictFrozenModel):
+    event_id: Identifier
+    kind: CostEventKind
+    simulated: Literal[True] = True
+    surfaces: tuple[CostSurface, ...]
+    parts: Annotated[tuple[CostPart, ...], Field(min_length=1)]
+    multiplicity: PositiveInt = 1
+
+    @model_validator(mode="after")
+    def require_distinct_surfaces(self) -> CostEvent:
+        if not self.surfaces or len(set(self.surfaces)) != len(self.surfaces):
+            raise ValueError("cost event surfaces must be nonempty and distinct")
+        return self
+
+
+class CostSummary(_StrictFrozenModel):
+    status: Literal["exact_local_text", "cannot_compare"]
+    reason_code: CostUnavailableReason | None
+    transport_bytes: NonnegativeInt
+    transport_tokens: NonnegativeInt | None
+    model_input_tokens: NonnegativeInt | None
+    model_output_tokens: NonnegativeInt | None
+    distinct_text_event_tokens: NonnegativeInt | None
+    event_kind_tokens: dict[CostEventKind, NonnegativeInt] | None
+    part_label_tokens: dict[CostPartLabel, int] | None
+
+    @model_validator(mode="after")
+    def consistent_measurement_state(self) -> CostSummary:
+        token_values = (
+            self.transport_tokens,
+            self.model_input_tokens,
+            self.model_output_tokens,
+            self.distinct_text_event_tokens,
+        )
+        if self.status == "cannot_compare":
+            if self.reason_code is None or any(value is not None for value in token_values):
+                raise ValueError("unknown measurement must not report token totals")
+            if self.event_kind_tokens is not None or self.part_label_tokens is not None:
+                raise ValueError("unknown measurement must not report token breakdowns")
+            return self
+        if self.reason_code is not None or any(value is None for value in token_values):
+            raise ValueError("exact measurement requires complete token totals")
+        if self.event_kind_tokens is None or self.part_label_tokens is None:
+            raise ValueError("exact measurement requires token breakdowns")
+        if (set(self.event_kind_tokens) != set(COST_EVENT_KINDS)
+                or set(self.part_label_tokens) != set(COST_PART_LABELS)):
+            raise ValueError("exact measurement breakdowns must be complete")
+        if (sum(self.event_kind_tokens.values()) != self.distinct_text_event_tokens
+                or sum(self.part_label_tokens.values()) != self.distinct_text_event_tokens):
+            raise ValueError("event and part totals must conserve complete event tokens")
+        return self
+
+
+class BreakEvenResult(_StrictFrozenModel):
+    status: Literal["finite", "never", "cannot_compare"]
+    first_strict_win: PositiveInt | None
+    reason_code: Literal["required_cost_unknown"] | None
+
+    @model_validator(mode="after")
+    def consistent_break_even_state(self) -> BreakEvenResult:
+        if self.status == "finite":
+            if self.first_strict_win is None or self.reason_code is not None:
+                raise ValueError("finite break-even requires a first strict win")
+        elif self.status == "never":
+            if self.first_strict_win is not None or self.reason_code is not None:
+                raise ValueError("never-winning break-even has no threshold")
+        elif self.first_strict_win is not None or self.reason_code is None:
+            raise ValueError("incomparable break-even requires an unknown-cost reason")
+        return self
diff --git a/src/agentcodec/agentwire/costs.py b/src/agentcodec/agentwire/costs.py
new file mode 100644
index 0000000..4514df6
--- /dev/null
+++ b/src/agentcodec/agentwire/costs.py
@@ -0,0 +1,215 @@
+"""Complete local AgentWire event accounting; never calls a model or provider."""
+
+from agentcodec.adaptive import meter
+from agentcodec.adaptive.contracts import (
+    MAX_HISTORY_EVENTS,
+    TextAttempt,
+    TextComponent,
+    TokenizerProfile,
+)
+from agentcodec.codec import FallbackRequired
+
+from .contracts import (
+    COST_EVENT_KINDS,
+    COST_PART_LABELS,
+    BreakEvenResult,
+    CostEvent,
+    CostEventKind,
+    CostPartLabel,
+    CostSummary,
+)
+
+
+_PART_COMPONENT_KIND = {
+    "setup": "setup",
+    "negotiation": "setup",
+    "protocol_instructions": "context",
+    "context": "context",
+    "dictionary_glossary": "context",
+    "dictionary_transfer": "setup",
+    "payload": "payload",
+    "response": "other",
+    "retry": "retry",
+    "fallback": "fallback",
+    "other": "other",
+}
+_EVENT_ATTEMPT_KIND = {
+    "setup": "setup",
+    "negotiation": "setup",
+    "dictionary_distribution": "setup",
+    "request": "initial",
+    "response": "other",
+    "retry": "retry",
+    "fallback": "fallback",
+}
+
+
+class _CostRejected(FallbackRequired):
+    code = "agentwire_invalid_cost"
+
+    def __init__(self) -> None:
+        super().__init__("AgentWire cost configuration rejected")
+
+
+def _unique_events(events: tuple[CostEvent, ...]) -> tuple[CostEvent, ...]:
+    if type(events) is not tuple or len(events) > MAX_HISTORY_EVENTS:
+        raise _CostRejected()
+    unique: dict[str, CostEvent] = {}
+    for value in events:
+        try:
+            event = CostEvent.model_validate(value, strict=True)
+        except (TypeError, ValueError):
+            raise _CostRejected() from None
+        previous = unique.get(event.event_id)
+        if previous is not None and previous != event:
+            raise _CostRejected()
+        unique[event.event_id] = event
+    return tuple(unique.values())
+
+
+def _attempts(events: tuple[CostEvent, ...]) -> tuple[TextAttempt, ...]:
+    attempts = []
+    for event in events:
+        try:
+            components = tuple(
+                TextComponent(
+                    kind=_PART_COMPONENT_KIND[part.label],
+                    text=part.text,
+                    resource_identity=None,
+                )
+                for part in event.parts
+            )
+            attempts.append(TextAttempt(
+                event_id=event.event_id,
+                attempt_kind=_EVENT_ATTEMPT_KIND[event.kind],
+                components=components,
+                simulated=True,
+                multiplicity=event.multiplicity,
+            ))
+        except (TypeError, ValueError, KeyError):
+            raise _CostRejected() from None
+    return tuple(attempts)
+
+
+def _transport_bytes(events: tuple[CostEvent, ...]) -> int:
+    return sum(
+        len("".join(part.text for part in event.parts).encode("utf-8"))
+        * event.multiplicity
+        for event in events
+        if "transport" in event.surfaces
+    )
+
+
+def _cannot_compare(events: tuple[CostEvent, ...], reason_code: str) -> CostSummary:
+    return CostSummary(
+        status="cannot_compare",
+        reason_code=reason_code,
+        transport_bytes=_transport_bytes(events),
+        transport_tokens=None,
+        model_input_tokens=None,
+        model_output_tokens=None,
+        distinct_text_event_tokens=None,
+        event_kind_tokens=None,
+        part_label_tokens=None,
+    )
+
+
+def measure_cost_events(
+    events: tuple[CostEvent, ...], profile: TokenizerProfile | None,
+) -> CostSummary:
+    """Measure unique complete events with the existing exact local text meter.
+
+    Surface totals are overlapping facets, while distinct_text_event_tokens
+    charges each event text once (with its declared multiplicity). Part deltas
+    retain the meter's signed prefix attribution and are explanations, not extra
+    costs. Repeated IDs must be fully identical; distinct IDs remain distinct
+    requests even when their text happens to match.
+    """
+    unique = _unique_events(events)
+    attempts = _attempts(unique)
+    transport_bytes = _transport_bytes(unique)
+    if profile is None:
+        return _cannot_compare(unique, "tokenizer_unavailable")
+    try:
+        measured = meter.measure_attempts(attempts, profile)
+    except meter.MeasurementUnavailable as error:
+        return _cannot_compare(unique, error.reason_code)
+    if len(measured) != len(unique):
+        raise _CostRejected()
+
+    event_totals: dict[CostEventKind, int] = dict.fromkeys(COST_EVENT_KINDS, 0)
+    part_totals: dict[CostPartLabel, int] = dict.fromkeys(COST_PART_LABELS, 0)
+    transport_tokens = 0
+    model_input_tokens = 0
+    model_output_tokens = 0
+    distinct_total = 0
+    for event, attempt, result in zip(unique, attempts, measured, strict=True):
+        if (result.event_id != event.event_id
+                or result.attempt_kind != attempt.attempt_kind
+                or result.simulated is not True
+                or result.multiplicity != event.multiplicity
+                or len(result.component_tokens) != len(event.parts)):
+            raise _CostRejected()
+        repeated_tokens = result.total_tokens * event.multiplicity
+        distinct_total += repeated_tokens
+        event_totals[event.kind] += repeated_tokens
+        if "transport" in event.surfaces:
+            transport_tokens += repeated_tokens
+        if "model_input" in event.surfaces:
+            model_input_tokens += repeated_tokens
+        if "model_output" in event.surfaces:
+            model_output_tokens += repeated_tokens
+        for part, delta in zip(event.parts, result.component_tokens, strict=True):
+            part_totals[part.label] += delta * event.multiplicity
+
+    return CostSummary(
+        status="exact_local_text",
+        reason_code=None,
+        transport_bytes=transport_bytes,
+        transport_tokens=transport_tokens,
+        model_input_tokens=model_input_tokens,
+        model_output_tokens=model_output_tokens,
+        distinct_text_event_tokens=distinct_total,
+        event_kind_tokens=event_totals,
+        part_label_tokens=part_totals,
+    )
+
+
+def calculate_break_even(
+    candidate_setup: int | None,
+    candidate_per_message: int | None,
+    baseline_setup: int | None,
+    baseline_per_message: int | None,
+) -> BreakEvenResult:
+    """Return the first positive N where candidate cost is strictly lower.
+
+    The inequality is evaluated with integers only:
+    candidate_setup + N*candidate_per_message < baseline_setup + N*baseline_per_message.
+    Equality is not a win. Unknown inputs remain incomparable rather than zero.
+    """
+    values = (candidate_setup, candidate_per_message, baseline_setup, baseline_per_message)
+    for value in values:
+        if value is not None and (type(value) is not int or value < 0):
+            raise _CostRejected()
+    if any(value is None for value in values):
+        return BreakEvenResult(
+            status="cannot_compare",
+            first_strict_win=None,
+            reason_code="required_cost_unknown",
+        )
+
+    candidate_setup, candidate_per_message, baseline_setup, baseline_per_message = values
+    setup_delta = candidate_setup - baseline_setup
+    per_message_savings = baseline_per_message - candidate_per_message
+    if per_message_savings > 0:
+        first = max(1, setup_delta // per_message_savings + 1)
+        return BreakEvenResult(status="finite", first_strict_win=first, reason_code=None)
+    if per_message_savings == 0:
+        if setup_delta < 0:
+            return BreakEvenResult(status="finite", first_strict_win=1, reason_code=None)
+        return BreakEvenResult(status="never", first_strict_win=None, reason_code=None)
+
+    # A more expensive per-message candidate can only win at N=1, if at all.
+    if setup_delta - per_message_savings < 0:
+        return BreakEvenResult(status="finite", first_strict_win=1, reason_code=None)
+    return BreakEvenResult(status="never", first_strict_win=None, reason_code=None)
diff --git a/src/agentcodec/agentwire/gateway.py b/src/agentcodec/agentwire/gateway.py
new file mode 100644
index 0000000..b907a8d
--- /dev/null
+++ b/src/agentcodec/agentwire/gateway.py
@@ -0,0 +1,178 @@
+"""Local, deterministic AgentWire receive adapters; no dispatch or execution."""
+
+from __future__ import annotations
+
+import json
+from typing import get_args
+
+from pydantic import ValidationError
+
+from agentcodec.agentwire.codec import decode_awp1
+from agentcodec.agentwire.contracts import (
+    AgentWireError,
+    BenchmarkCandidate,
+    GatewayDelivery,
+    GatewayResult,
+    ReceiverCapabilities,
+    dictionary_identity_for,
+)
+from agentcodec.codec import FallbackRequired
+from agentcodec.evaluation import formats as evaluation_formats
+from agentcodec.schema import MessageV1, UserDictionary
+
+
+_CANDIDATES = frozenset(get_args(BenchmarkCandidate))
+_DICTIONARY_CANDIDATES = frozenset(
+    {"ac1_dictionary", "ac2_dictionary", "awp1_dictionary"}
+)
+_FORMATS = {
+    "natural_language": "natural_language",
+    "json": "json",
+    "ac1": "ac1",
+    "ac1_dictionary": "ac1",
+    "ac2": "ac2",
+    "ac2_dictionary": "ac2",
+    "awp1": "awp1",
+    "awp1_dictionary": "awp1",
+}
+
+
+def _fallback_gateway(reason_code: str) -> GatewayResult:
+    return GatewayResult(
+        status="fallback_required", message=None, reason_code=reason_code
+    )
+
+
+def _fallback_delivery(
+    candidate_id: BenchmarkCandidate, reason_code: str
+) -> GatewayDelivery:
+    return GatewayDelivery(
+        candidate_id=candidate_id,
+        decode_status="fallback_required",
+        model_context=None,
+        pass_through_text=None,
+        reason_code=reason_code,
+    )
+
+
+def _canonical_context(message: MessageV1) -> str:
+    snapshot = MessageV1.model_validate(vars(message), strict=True)
+    return json.dumps(
+        snapshot.model_dump(),
+        ensure_ascii=False,
+        separators=(",", ":"),
+        allow_nan=False,
+    )
+
+
+def _selected_dictionary_reason(
+    receiver: ReceiverCapabilities, dictionary: UserDictionary | None
+) -> str | None:
+    if dictionary is None:
+        return "dictionary_missing"
+    if not isinstance(dictionary, UserDictionary):
+        return "dictionary_identity_mismatch"
+    try:
+        identity = dictionary_identity_for(dictionary)
+    except (ValidationError, TypeError, ValueError, AttributeError, RecursionError):
+        return "dictionary_identity_mismatch"
+    if receiver.dictionary_identity is None:
+        return "dictionary_missing"
+    if identity != receiver.dictionary_identity or identity.user_id != receiver.user_id:
+        return "dictionary_identity_mismatch"
+    return None
+
+
+def decode_at_gateway(
+    payload: str,
+    receiver: ReceiverCapabilities,
+    dictionary: UserDictionary | None = None,
+) -> GatewayResult:
+    """Strictly decode only AWP1, returning a complete message or a stable failure."""
+    try:
+        message = decode_awp1(payload, receiver, dictionary=dictionary)
+        return GatewayResult(
+            status="decoded", message=message, reason_code=None
+        )
+    except AgentWireError as error:
+        return _fallback_gateway(error.reason_code)
+    except (ValidationError, TypeError, ValueError, AttributeError, RecursionError):
+        return _fallback_gateway("invalid_message")
+
+
+def deliver_benchmark_at_gateway(
+    candidate_id: BenchmarkCandidate,
+    payload: str,
+    receiver: ReceiverCapabilities,
+    dictionary: UserDictionary | None = None,
+) -> GatewayDelivery:
+    """Decode one explicitly declared offline benchmark format without guessing."""
+    try:
+        known_candidate = isinstance(candidate_id, str) and candidate_id in _CANDIDATES
+    except TypeError:
+        known_candidate = False
+    if not known_candidate:
+        raise ValueError("unsupported benchmark candidate") from None
+
+    if not isinstance(receiver, ReceiverCapabilities):
+        return _fallback_delivery(candidate_id, "invalid_message")
+
+    if candidate_id == "natural_language_freeform":
+        if dictionary is not None:
+            return _fallback_delivery(candidate_id, "dictionary_identity_mismatch")
+        if not isinstance(payload, str):
+            return _fallback_delivery(candidate_id, "invalid_message")
+        return GatewayDelivery(
+            candidate_id=candidate_id,
+            decode_status="pass_through",
+            model_context=None,
+            pass_through_text=payload,
+            reason_code=None,
+        )
+
+    uses_dictionary = candidate_id in _DICTIONARY_CANDIDATES
+    if uses_dictionary:
+        dictionary_reason = _selected_dictionary_reason(receiver, dictionary)
+        if dictionary_reason is not None:
+            return _fallback_delivery(candidate_id, dictionary_reason)
+    elif dictionary is not None:
+        return _fallback_delivery(candidate_id, "dictionary_identity_mismatch")
+
+    if candidate_id in {"awp1", "awp1_dictionary"}:
+        result = decode_at_gateway(payload, receiver, dictionary=dictionary)
+        if result.status == "fallback_required":
+            return _fallback_delivery(candidate_id, result.reason_code)
+        message = result.message
+    else:
+        declared_format = _FORMATS[candidate_id]
+        try:
+            message = evaluation_formats.parse_input(
+                payload,
+                declared_format,
+                receiver.user_id,
+                dictionary=dictionary,
+            )
+        except (
+            FallbackRequired,
+            ValidationError,
+            TypeError,
+            ValueError,
+            KeyError,
+            AttributeError,
+            RecursionError,
+        ):
+            # Existing parsers do not expose a stable reason taxonomy. Keep this
+            # boundary non-revealing instead of copying parser text or input data.
+            return _fallback_delivery(candidate_id, "invalid_message")
+
+    try:
+        model_context = _canonical_context(message)
+    except (ValidationError, TypeError, ValueError, AttributeError, RecursionError):
+        return _fallback_delivery(candidate_id, "invalid_message")
+    return GatewayDelivery(
+        candidate_id=candidate_id,
+        decode_status="decoded",
+        model_context=model_context,
+        pass_through_text=None,
+        reason_code=None,
+    )
